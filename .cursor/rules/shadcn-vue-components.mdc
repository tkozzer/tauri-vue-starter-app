## Customization Guidelines

### Theme Customization
```ts
// lib/utils.ts - Extend the cn utility if needed
import { type ClassValue, clsx } from 'clsx'
import { twMerge } from 'tailwind-merge'

export function cn(...inputs: ClassValue[]) {
  return twMerge(clsx(inputs))
}

// Custom variant helper
export function buttonVariants(variant: 'primary' | 'danger') {
  return cn({
    'bg-black text-white hover:bg-neutral-800': variant === 'primary',
    'bg-red-600 text-white hover:bg-red-700': variant === 'danger',
  })
}
```

### Component Extension
```vue
<!-- Create custom components that extend shadcn components -->
<template>
  <UiButton 
    :class="cn(
      'transition-all duration-200',
      variant === 'primary' && 'bg-black hover:bg-neutral-800',
      variant === 'danger' && 'bg-red-600 hover:bg-red-700',
      className
    )"
    v-bind="$attrs"
  >
    <slot />
  </UiButton>
</template>

<script lang="ts" setup>
import { Button as UiButton } from '@/components/ui/button'
import { cn } from '@/lib/utils'

interface Props {
  variant?: 'primary' | 'danger'
  className?: string
}

defineProps<Props>()
</script>
```

## Best Practices

### Component Organization
```
src/
  components/
    ui/           # Shadcn components (auto-generated)
      button/
      card/
      input/
    common/       # Custom reusable components
      AppHeader.vue
      AppSidebar.vue
    features/     # Feature-specific components
      UserList.vue
      DataTable.vue
```

### Performance Considerations
- **Import only needed components** to reduce bundle size
- **Use local registration** for components used in few places
- **Use global registration** for components used throughout the app
- **Lazy load** large component sets when possible

### Type Safety
```vue
<script lang="ts" setup>
// Always type your props and emits
interface Props {
  users: User[]
  loading?: boolean
}

interface Emits {
  'user-selected': [user: User]
  'refresh': []
}

const props = withDefaults(defineProps<Props>(), {
  loading: false
})

const emit = defineEmits<Emits>()
</script>
```

### Accessibility
- **Always include proper labels** for form inputs
- **Use semantic HTML** within shadcn components
- **Test keyboard navigation** for interactive components
- **Ensure proper contrast** with the neutral color scheme

### Error Handling
```vue
<script lang="ts" setup>
import { ref } from 'vue'
import { useToast } from '@/components/ui/toast'

const { toast } = useToast()

const handleError = (error: Error) => {
  toast({
    title: 'Error',
    description: error.message,
    variant: 'destructive',
  })
}
</script>
```